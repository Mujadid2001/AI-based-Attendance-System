# PythonAnywhere deployment environment template.
# Copy this file to ~/AI-based-Attendance-System/.env and replace every
# placeholder. Do not commit the resulting .env file.

DEBUG=False
SECRET_KEY=<generate-a-new-secret-key-at-least-50-characters>
DJANGO_SETTINGS_MODULE=config.settings.production

# PythonAnywhere account and web app
ALLOWED_HOSTS=<username>.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=https://<username>.pythonanywhere.com
CORS_ALLOWED_ORIGINS=https://<frontend-domain>
CORS_ALLOW_ALL_ORIGINS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# PythonAnywhere MySQL values from the Databases tab
DB_ENGINE=django.db.backends.mysql
DB_NAME=<username>$<database-name>
DB_USER=<username>
DB_PASSWORD=<mysql-password>
DB_HOST=<username>.mysql.pythonanywhere-services.com
DB_PORT=3306
USE_REDIS=False

# Optional SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI Attendance <noreply@example.com>

# Application
ENCRYPTION_KEY=<generate-a-valid-fernet-key>
MAX_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=100
GENERAL_RATE_LIMIT=200
BLOCK_SUSPICIOUS_REQUESTS=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SERVER_BASE_URL=https://<username>.pythonanywhere.com
SERVER_PORT=443
FORCE_DYNAMIC_IP_DETECTION=False
