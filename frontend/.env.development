# ===============================================
# AI ATTENDANCE SYSTEM - FRONTEND CONFIGURATION
# ===============================================

# API Configuration - REQUIRED
# Point this to your backend API URL
# Development: https://localhost:8000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:8000/api

# Note: If frontend runs on port 3001, update this in browser URL
# CORS is configured for both ports 3000 and 3001

# App Configuration
VITE_APP_NAME=AI Attendance System
VITE_APP_VERSION=1.0.0

# Environment
# development | production
NODE_ENV=development

# Optional: API timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# Optional: Enable debug mode
VITE_DEBUG=true
