[Unit]
Description=AI-Based Attendance System API
After=network.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/attendance-system/attendance_system

Environment="PATH=/opt/attendance-system/venv/bin"
Environment="DJANGO_SETTINGS_MODULE=config.settings.production"

ExecStart=/opt/attendance-system/venv/bin/gunicorn \
    --config /opt/attendance-system/gunicorn_config.py \
    --name attendance-api \
    --workers 5 \
    --bind 127.0.0.1:8000 \
    config.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
KillSignal=SIGTERM

# Auto-restart on failure
Restart=always
RestartSec=10

# Security
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
