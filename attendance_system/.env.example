# Backend API Environment Variables Example
# Copy this file to .env and configure your settings

# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration for Frontend (SECURITY CRITICAL)
# Add ONLY trusted frontend URLs (comma-separated, no spaces around commas)
# Development example (default if not set):
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Production example (REQUIRED - replace with your actual domains):
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# 
# SECURITY WARNING: Never use wildcard (*) or enable CORS_ALLOW_ALL_ORIGINS in production
CORS_ALLOW_ALL_ORIGINS=False

# Database Configuration (SQLite for development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# For PostgreSQL (recommended for production):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=attendance_db
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@attendance.com

# JWT Configuration (optional - has defaults)
# JWT_ACCESS_TOKEN_LIFETIME=60
# JWT_REFRESH_TOKEN_LIFETIME=1440

# Redis Configuration (for production)
# REDIS_URL=redis://127.0.0.1:6379/0

# AWS S3 Configuration (for production media storage)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1
