# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging
build/
develop-eggs/
dist/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# Virtual environments
# =============================================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# =============================================================================
# Environment variables - never commit real secrets
# =============================================================================
.env
.env.local
.env.*.local
.env.development
.env.deployment

# .env.production IS committed on purpose: it is the documented template of
# every setting name, with placeholders only and no real credentials.
!.env.production

# =============================================================================
# Django
# =============================================================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# Collected static output and uploaded media are generated at deploy time:
#     python attendance_system/manage.py collectstatic --noinput
# They are never committed, and must live inside /home/<username>/ on
# PythonAnywhere.
attendance_system/staticfiles/
attendance_system/media/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log

