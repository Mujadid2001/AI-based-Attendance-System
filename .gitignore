# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Packaging
build/
develop-eggs/
dist/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# =============================================================================
# Virtual environments
# =============================================================================
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# =============================================================================
# Environment variables - never commit real secrets
# =============================================================================
.env
.env.local
.env.*.local
.env.development
.env.deployment

# .env.production IS committed on purpose: it is the documented template of
# every setting name, with placeholders only and no real credentials.
!.env.production

# =============================================================================
# Django
# =============================================================================
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# Collected static output and uploaded media are generated at deploy time:
#     python attendance_system/manage.py collectstatic --noinput
# They are never committed, and must live inside /home/<username>/ on
# PythonAnywhere.
attendance_system/staticfiles/
attendance_system/media/

# =============================================================================
# Runtime AI assets
# =============================================================================
# models/shape_predictor_68_face_landmarks.dat  - 96 MB. Too large for git, and
#   useless where dlib is not installed (which is everywhere on PythonAnywhere).
#   Download it manually if you want local face alignment - see models/README.md.
# models/face_encodings.pkl  - cached 128-dimension face encodings, i.e.
#   BIOMETRIC DATA. Never belongs in version control, and certainly not in a
#   public repository. The app regenerates it.
models/*
!models/README.md

# =============================================================================
# PythonAnywhere disk quota
# =============================================================================
# The shared/free tiers cap /home/<username> at 512 MB, which a virtualenv plus
# a git checkout can exhaust on its own. Install with --no-cache-dir and purge
# ~/.cache/pip if you hit "Disk quota exceeded".
.venv/

# =============================================================================
# Logs
# =============================================================================
logs/
*.log

