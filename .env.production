# Production Environment
DEBUG=False
SECRET_KEY=GENERATE_A_SECURE_KEY_HERE_50_CHARS_MINIMUM
DJANGO_SETTINGS_MODULE=config.settings.production

# Database - PostgreSQL Required
DB_ENGINE=django.db.backends.postgresql
DB_NAME=attendance_db
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_HOST=db
DB_PORT=5432

# Security - Strict for production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Email - Real SMTP for production
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=AI Attendance <noreply@yourdomain.com>

# Redis - Required for production
REDIS_URL=redis://redis:6379/0

# ===============================================
# NETWORK CONFIGURATION
# ===============================================
# For QR code generation and external device connectivity
# 
# Production: Set to your public domain or server IP
# Examples:
#   - Public domain: https://attendance.yourdomain.com
#   - LAN deployment: http://192.168.1.100:8000
#   - Docker: http://HOST_MACHINE_IP:8000
SERVER_BASE_URL=https://yourdomain.com
SERVER_PORT=443

# Force dynamic IP detection (False for production with fixed domain)
FORCE_DYNAMIC_IP_DETECTION=False
