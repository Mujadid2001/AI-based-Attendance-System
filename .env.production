# Production environment template.
# Copy to .env on the production server and replace every placeholder.
DEBUG=False
SECRET_KEY=<generate-a-new-secret-key-at-least-50-characters>
DJANGO_SETTINGS_MODULE=config.settings.production

# Database
DB_ENGINE=django.db.backends.postgresql
DB_NAME=attendance_db
DB_USER=<database-user>
DB_PASSWORD=<database-password>
DB_HOST=<database-host>
DB_PORT=5432
USE_REDIS=True
REDIS_URL=redis://redis:6379/0

# Security
ALLOWED_HOSTS=<api-domain>
CSRF_TRUSTED_ORIGINS=https://<api-domain>
CORS_ALLOWED_ORIGINS=https://<frontend-domain>
CORS_ALLOW_ALL_ORIGINS=False
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<smtp-username>
EMAIL_HOST_PASSWORD=<smtp-password>
DEFAULT_FROM_EMAIL=AI Attendance <noreply@<api-domain>>

# Application
ENCRYPTION_KEY=<generate-a-valid-fernet-key>
MAX_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=100
GENERAL_RATE_LIMIT=200
BLOCK_SUSPICIOUS_REQUESTS=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=True
SERVER_BASE_URL=https://<api-domain>
SERVER_PORT=443
FORCE_DYNAMIC_IP_DETECTION=False
