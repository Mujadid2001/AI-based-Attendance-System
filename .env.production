###############################################################################
# AI-based Attendance System - PRODUCTION TEMPLATE (PythonAnywhere)
###############################################################################
# On the server:
#
#     cp .env.production .env
#     nano .env                  # fill in the lines marked >>> CHANGE_ME
#     diff .env .env.production  # confirm nothing is left
#
# The local `.env` in this repo has the SAME setting names with real working
# values, so copy anything you are unsure about straight across.
#
# Everything except EMAIL_HOST_PASSWORD is already correct for this project.
# Do NOT commit the resulting .env - it is git-ignored.
###############################################################################


# =============================================================================
# 1. DJANGO CORE
# =============================================================================

DJANGO_SETTINGS_MODULE=config.settings.production

# production.py forces this to False no matter what is set here.
DEBUG=False

# Identical to the local .env on purpose, so one file works everywhere.
# Regenerate if it ever leaks:
#   python -c "import secrets,string;a=string.ascii_letters+string.digits+'-_=+.';print(''.join(secrets.choice(a) for _ in range(64)))"
#
# The file is also valid shell: `set -a; . ./.env.production; set +a`
SECRET_KEY=.+YGME7QkU1LGQ1=SqcIm.44_Fto-GWcGd7syQCrJ+YCn87goOw6PgPlCg0G.NqX

# Encrypts sensitive columns. Changing it makes existing rows unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gYF2SlPxlZQSt-lgyaBtfIhiLeSpJTI5NKgvHuRY6U4=


# =============================================================================
# 2. DATABASE  (SQLite, inside the project folder)
# =============================================================================
# The file lands at:
#     /home/mujadid/AI-based-Attendance-System/attendance_system/db.sqlite3
#
# It must stay inside /home/mujadid/ or PythonAnywhere cannot read it.
# Create it with:
#     python attendance_system/manage.py migrate
#
# SQLite is fine while you are the only user. It locks the whole database for
# every write, so as soon as two people use it at the same time switch to the
# free MySQL that comes with PythonAnywhere (Databases tab -> create -> paste
# the five values here):
#     DB_ENGINE=django.db.backends.mysql
#     DB_NAME=mujadid$attendance_db
#     DB_USER=mujadid
#     DB_PASSWORD=<from the Databases tab>
#     DB_HOST=mujadid.mysql.pythonanywhere-services.com
#     DB_PORT=3306

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=


# =============================================================================
# 3. HOSTS, CORS AND CSRF
# =============================================================================

ALLOWED_HOSTS=mujadid.pythonanywhere.com

# The React app's origin. The browser compares this EXACTLY - scheme, host and
# port - and a mismatch is the #1 cause of "blocked by CORS policy".
#
# Left at localhost:3000 because the frontend is not deployed yet. You MUST
# replace this with the real deployed origin before the hosted frontend will
# work, and it must match frontend/.env.production's deployment.
#
# >>> CHANGE_ME e.g. https://ai-attendance.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Same value as CORS_ALLOWED_ORIGINS.
# >>> CHANGE_ME
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Base URL used to build password-reset / verification links inside emails.
# >>> CHANGE_ME
FRONTEND_URL=http://localhost:3000

# production.py refuses to start if this is True.
CORS_ALLOW_ALL_ORIGINS=False


# =============================================================================
# 4. HTTPS
# =============================================================================
# PythonAnywhere terminates TLS and forwards X-Forwarded-Proto, which the app
# reads via SECURE_PROXY_SSL_HEADER. Leaving this True does NOT cause a
# redirect loop.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Start at 0. Once the domain has been https-only for a while, set 31536000
# (1 year) and the two flags below to True. Browsers cache HSTS aggressively
# and there is no easy way back.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False


# =============================================================================
# 5. EMAIL
# =============================================================================
# Without this, password reset and email verification do not work at all: the
# reset link is generated but never delivered.
#
# To get the app password:
#   1. Turn on 2-Step Verification at
#      https://myaccount.google.com/security
#   2. Then create a password at
#      https://myaccount.google.com/apppasswords
#      (name it "AI Attendance", copy the 16-character code)
#
# Keep EMAIL_USE_TLS=True with port 587.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=mujadid2001@gmail.com

# >>> CHANGE_ME paste your 16-character Google App Password here.
#     Left empty on purpose so the real secret is never written to a repo.
EMAIL_HOST_PASSWORD=

# Quoted because the value contains spaces and angle brackets. python-decouple
# strips the quotes, and quoting also keeps the file sourceable by `sh`/`bash`.
DEFAULT_FROM_EMAIL="AI Attendance <mujadid2001@gmail.com>"


# =============================================================================
# 6. REDIS / CACHES / WEBSOCKETS
# =============================================================================
# PythonAnywhere has no Redis server. Keep this False: the app uses in-process
# cache and channel layers, which work fine for a single web worker.
USE_REDIS=False
REDIS_URL=redis://127.0.0.1:6379/0


# =============================================================================
# 7. CELERY
# =============================================================================
# No worker and no beat scheduler on PythonAnywhere, so tasks run inline inside
# the web request. Reports and reminder emails still work, they just are not
# backgrounded.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=True
CELERY_TASK_EAGER_PROPAGATES=False


# =============================================================================
# 8. RATE LIMITING / SESSIONS
# =============================================================================
MAX_REQUESTS_PER_MINUTE=100
AUTH_RATE_LIMIT=20
API_RATE_LIMIT=100
GENERAL_RATE_LIMIT=200
BLOCK_SUSPICIOUS_REQUESTS=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=True


# =============================================================================
# 9. SERVER URL  (QR codes, mobile camera links, emailed links)
# =============================================================================
SERVER_BASE_URL=https://mujadid.pythonanywhere.com
SERVER_PORT=443
FORCE_DYNAMIC_IP_DETECTION=False


# =============================================================================
# 10. FILE SERVING
# =============================================================================
# Run before the first reload:
#     python attendance_system/manage.py collectstatic --noinput
#
# Web tab -> Static files:
#     /static/  ->  /home/mujadid/AI-based-Attendance-System/attendance_system/staticfiles
#     /media/   ->  /home/mujadid/AI-based-Attendance-System/attendance_system/media
#
# WhiteNoise serves /static/ even without the mapping. Media has no fallback,
# so either map it or leave SERVE_MEDIA_FILES=True as below.
SERVE_STATIC_FILES=False
SERVE_MEDIA_FILES=True

MAX_UPLOAD_SIZE_MB=10

# Empty = attendance_system/media. Must stay inside /home/mujadid/.
MEDIA_ROOT=
