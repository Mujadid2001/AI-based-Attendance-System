# Development Environment
DEBUG=True
SECRET_KEY=dev-insecure-key-change-this-if-needed
DJANGO_SETTINGS_MODULE=config.settings.development

# Database - SQLite
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Security - Relaxed for development
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://localhost:3000,https://127.0.0.1:3000,https://localhost:5173,https://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Email - Console backend for development
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=AI Attendance <noreply@attendance.local>

# Redis - Optional for development
REDIS_URL=redis://127.0.0.1:6379/0

# ===============================================
# NETWORK CONFIGURATION
# ===============================================
# For QR code generation and external device connectivity
# 
# Development: Leave empty for automatic local network IP detection
# This ensures mobile devices on the same network can connect
SERVER_BASE_URL=
SERVER_PORT=8000

# Force dynamic IP detection (recommended for development)
FORCE_DYNAMIC_IP_DETECTION=True
