# 🐳 Production-Grade Dockerfile for Government Deployment

# =============================================================================
# MULTI-STAGE BUILD FOR OPTIMIZED PRODUCTION IMAGE
# =============================================================================

ARG PYTHON_VERSION=3.11
ARG ENVIRONMENT=production

# =============================================================================
# STAGE 1: Build Dependencies and Compile Native Extensions
# =============================================================================
FROM python:${PYTHON_VERSION}-slim as builder

# Build arguments
ARG ENVIRONMENT
ENV ENVIRONMENT=${ENVIRONMENT}

# Install system dependencies for building
RUN apt-get update && apt-get install -y \
    # Essential build tools
    build-essential \
    gcc \
    g++ \
    cmake \
    pkg-config \
    # Python development headers
    python3-dev \
    # Image processing libraries
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libwebp-dev \
    libopenjp2-7-dev \
    # Face recognition dependencies
    libopenblas-dev \
    liblapack-dev \
    libx11-dev \
    libgtk-3-dev \
    libboost-python-dev \
    # OpenCV dependencies
    libopencv-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer1.0-dev \
    # Audio processing
    libsndfile1-dev \
    # Database clients
    libpq-dev \
    # SSL/TLS
    libssl-dev \
    libffi-dev \
    # Download tools
    wget \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Create app directory
WORKDIR /app

# Install Python dependencies
COPY requirements.txt requirements-production.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements-production.txt

# =============================================================================  
# STAGE 2: Runtime Environment (Government-Grade Security)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim as runtime

# Build arguments
ARG ENVIRONMENT
ENV ENVIRONMENT=${ENVIRONMENT}

# Security: Create non-root user for application
RUN groupadd -r appgroup && \
    useradd --no-log-init -r -g appgroup appuser

# Install only runtime dependencies (minimal attack surface)
RUN apt-get update && apt-get install -y \
    # Runtime libraries only (no build tools)
    libjpeg62-turbo \
    libpng16-16 \
    libtiff5 \
    libwebp7 \
    libopenjp2-7 \
    libopenblas0 \
    liblapack3 \
    libgtk-3-0 \
    libopencv-core4.5d \
    libopencv-imgproc4.5d \
    libopencv-highgui4.5d \
    libavcodec58 \
    libavformat58 \
    libswscale5 \
    libsndfile1 \
    # Database client libraries
    libpq5 \
    # Network utilities for health checks
    curl \
    wget \
    # Process management
    supervisor \
    # Log rotation
    logrotate \
    # Security tools
    ca-certificates \
    # Time zone support
    tzdata \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Copy Python packages from builder stage
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Create application directories with proper permissions
RUN mkdir -p /app/staticfiles /app/media /app/logs /app/ssl && \
    chown -R appuser:appgroup /app

# Set working directory
WORKDIR /app

# Copy application code
COPY --chown=appuser:appgroup . .

# Copy configuration files
COPY --chown=appuser:appgroup config/gunicorn_config.py /app/
COPY --chown=appuser:appgroup config/supervisor/ /etc/supervisor/conf.d/
COPY --chown=appuser:appgroup config/logrotate/ /etc/logrotate.d/

# Set proper permissions for sensitive files
RUN chmod 600 /app/config/settings/*.py && \
    chmod 755 /app/scripts/*.sh && \
    chmod 644 /app/requirements*.txt

# =============================================================================
# SECURITY HARDENING
# =============================================================================

# Remove unnecessary packages and clean up
RUN apt-get autoremove -y && \
    apt-get autoclean && \
    rm -rf /tmp/* /var/tmp/* /root/.cache

# Set secure file permissions
RUN find /app -type f -name "*.py" -exec chmod 644 {} \; && \
    find /app -type d -exec chmod 755 {} \; && \
    find /app/scripts -type f -name "*.sh" -exec chmod 755 {} \;

# Create restricted directories
RUN mkdir -p /app/audit_logs && \
    chown appuser:appgroup /app/audit_logs && \
    chmod 700 /app/audit_logs

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Environment variables for production
ENV DJANGO_SETTINGS_MODULE=config.settings.production \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    # Security settings
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    # Application settings
    WORKERS=4 \
    WORKER_TIMEOUT=120 \
    WORKER_CLASS=sync \
    MAX_REQUESTS=1000 \
    MAX_REQUESTS_JITTER=50 \
    PRELOAD_APP=true

# Set timezone (configurable via environment)
ENV TZ=${TZ:-UTC}
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================

# Add health check script
COPY scripts/health_check.sh /usr/local/bin/health_check.sh
RUN chmod +x /usr/local/bin/health_check.sh && \
    chown appuser:appgroup /usr/local/bin/health_check.sh

# Health check endpoint
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD ["/usr/local/bin/health_check.sh"]

# =============================================================================
# MONITORING AND LOGGING SETUP
# =============================================================================

# Copy logging configuration
COPY config/logging/ /app/config/logging/

# Create log directories
RUN mkdir -p /app/logs/{application,security,audit,access,error} && \
    chown -R appuser:appgroup /app/logs && \
    chmod -R 755 /app/logs

# Setup log rotation
COPY config/logrotate/attendance-system /etc/logrotate.d/
RUN chmod 644 /etc/logrotate.d/attendance-system

# =============================================================================
# STARTUP SCRIPTS AND PROCESS MANAGEMENT
# =============================================================================

# Copy startup scripts
COPY scripts/docker-entrypoint.sh /usr/local/bin/
COPY scripts/wait-for-it.sh /usr/local/bin/
COPY scripts/migrate-and-collect.sh /usr/local/bin/

# Make scripts executable
RUN chmod +x /usr/local/bin/docker-entrypoint.sh && \
    chmod +x /usr/local/bin/wait-for-it.sh && \
    chmod +x /usr/local/bin/migrate-and-collect.sh && \
    chown appuser:appgroup /usr/local/bin/docker-entrypoint.sh && \
    chown appuser:appgroup /usr/local/bin/wait-for-it.sh && \
    chown appuser:appgroup /usr/local/bin/migrate-and-collect.sh

# =============================================================================
# COMPLIANCE AND AUDIT SETUP  
# =============================================================================

# Create audit directories and files
RUN mkdir -p /app/compliance/{policies,procedures,evidence} && \
    touch /app/compliance/audit_trail.log && \
    touch /app/compliance/security_events.log && \
    chown -R appuser:appgroup /app/compliance && \
    chmod -R 750 /app/compliance

# Copy compliance templates
COPY compliance/ /app/compliance/templates/
RUN chown -R appuser:appgroup /app/compliance/templates && \
    chmod -R 644 /app/compliance/templates

# =============================================================================
# FINAL SECURITY MEASURES
# =============================================================================

# Switch to non-root user (CRITICAL for security)
USER appuser

# Expose ports (documentation only - actual port binding in docker-compose)
EXPOSE 8000

# Set working directory
WORKDIR /app

# Default entrypoint and command
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["gunicorn", "--config", "/app/gunicorn_config.py", "config.wsgi:application"]

# =============================================================================
# LABELS FOR CONTAINER METADATA
# =============================================================================
LABEL org.label-schema.name="Government AI Attendance System" \
      org.label-schema.description="Enterprise-grade attendance management with government compliance" \
      org.label-schema.version="2.0.0" \
      org.label-schema.vendor="Your Organization" \
      org.label-schema.schema-version="1.0" \
      security.level="government-grade" \
      compliance.gdpr="true" \
      compliance.ferpa="true" \
      compliance.hipaa="true" \
      deployment.environment="${ENVIRONMENT}"